{
  "name": "solvebench",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Terminal workbench for solving coding exercises with an editor, test runner and optional context-aware assistant.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blitz00X/solvebench.git"
  },
  "bugs": {
    "url": "https://github.com/Blitz00X/solvebench/issues"
  },
  "homepage": "https://github.com/Blitz00X/solvebench#readme",
  "keywords": [
    "coding-exercises",
    "exercism",
    "leetcode",
    "terminal",
    "tui",
    "opentui",
    "solidjs",
    "bun",
    "typescript",
    "education"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:acceptance": "bun test apps/tui/src/__tests__/exercise-keys.test.tsx apps/tui/src/__tests__/exercise-ui.test.tsx apps/tui/test/exercise-session.test.ts",
    "dev": "bun apps/tui/src/main.tsx",
    "verify:persistence": "bun test packages/storage",
    "verify:docs": "bun scripts/check-docs.ts",
    "verify:release": "bun scripts/check-release-tree.ts",
    "check:launcher": "bash scripts/check-launcher.sh",
    "verify:catalog": "bun scripts/verify-catalog.ts",
    "verify:cses": "bun scripts/verify-cses.ts",
    "verify:runner": "bun test packages/exercise/test/runners.test.ts",
    "verify:workbench": "bun scripts/verify-workbench.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "solid-js": "1.9.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "typescript": "5.9.2"
  },
  "bin": {
    "solvebench": "./bin/solvebench",
    "pairs": "./bin/pairs"
  }
}
