# Copy to .env and fill in your key. .env is gitignored.
# The app reads the key from whichever variable your solvebench.config.json names.

# OpenAI-compatible endpoints
SOLVEBENCH_API_KEY=

# Common alternatives (use one and set apiKeyEnv accordingly)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
